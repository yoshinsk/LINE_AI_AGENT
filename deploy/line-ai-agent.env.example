# <PROJECT_ROOT>\deploy\line-ai-agent.env.example
# サーバ側 /path/to/private/line-ai-agent.env の例です。
# 実値は本番サーバ上だけに置き、Gitには入れません。

LINE_CHANNEL_ID=2000000000
LINE_CHANNEL_SECRET=change-me-channel-secret
LINE_CHANNEL_ACCESS_TOKEN=change-me-channel-access-token

LINE_AI_AGENT_DB_HOST=localhost
LINE_AI_AGENT_DB_NAME=line_ai_agent
LINE_AI_AGENT_DB_USER=line_ai_agent
LINE_AI_AGENT_DB_PASS=change-me-db-password

LINE_AI_AGENT_WORKER_TOKEN=change-me-long-random-worker-token
LINE_AI_AGENT_ACK_TEXT=改めて返信します。少々お待ちください。
LINE_AI_AGENT_ATTACHMENT_ACK_TEXT=改めて返信します。少々お待ちください。
LINE_AI_AGENT_ACK_MIN_CHARS=80
LINE_AI_AGENT_ACK_KEYWORDS=実装,修正,変更,調査,確認,解析,分析,要約,作成,生成,添付,ファイル,画像,ログ,エラー,テスト実行,テストを実行,デプロイ,配置,DB,データベース,commit,push,build,debug,review,tests

# 公開root外に保存されます。相対指定時はアプリ配置ルート基準です。
LINE_AI_AGENT_ATTACHMENT_DIR=private/attachments
LINE_AI_AGENT_ATTACHMENT_MAX_BYTES=26214400
LINE_AI_AGENT_ATTACHMENT_RECENT_MINUTES=30
# 添付を受信後に別メッセージで指示した場合、同一会話で再利用する時間です。
LINE_AI_AGENT_ATTACHMENT_CONTEXT_MINUTES=30
LINE_AI_AGENT_ATTACHMENT_MAX_PER_JOB=5

# 既定では危険拡張子だけ拒否します。許可拡張子を固定する場合だけ設定してください。
LINE_AI_AGENT_ATTACHMENT_ALLOWED_EXTENSIONS=
LINE_AI_AGENT_ATTACHMENT_BLOCKED_EXTENSIONS=exe,bat,cmd,com,msi,ps1,sh,bash,zsh,fish,js,vbs,wsf,hta,php,py,rb,pl,jar,dll,so,dylib,docm,xlsm,pptm,zip,rar,7z,tar,gz,bz2,xz

# ワーカーが生成した成果物は公開URL化してLINEへ返します。相対パスは public/line/ 基準です。
LINE_AI_AGENT_PUBLIC_BASE_URL=https://example.com/line
LINE_AI_AGENT_PUBLIC_ASSET_DIR=assets/generated
LINE_AI_AGENT_RESULT_ASSET_MAX_BYTES=10485760
LINE_AI_AGENT_RESULT_ASSET_ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,webp,txt,md,csv,tsv,json,pdf,docx,xlsx,pptx
LINE_AI_AGENT_RESULT_ASSET_BLOCKED_EXTENSIONS=exe,bat,cmd,com,msi,ps1,sh,bash,zsh,fish,js,vbs,wsf,hta,php,py,rb,pl,jar,dll,so,dylib,html,xhtml,svg,xml,docm,xlsm,pptm,zip,rar,7z,tar,gz,bz2,xz
