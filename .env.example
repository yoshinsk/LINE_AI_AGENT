# <PROJECT_ROOT>\.env.example
# Windowsワーカー用の設定例です。本番トークンやDBパスワードはGitに入れません。

LINE_AGENT_API_BASE_URL=https://example.com/line/internal.php
LINE_AI_AGENT_WORKER_TOKEN=change-me-worker-token
LINE_AI_AGENT_WORKER_ID=win11-codex-worker

# Codex実行コマンド。{output_file} を含めると最終回答ファイルを優先回収します。
CODEX_COMMAND=
CODEX_COMMAND_TIMEOUT_SECONDS=1800
CODEX_REPLY_MAX_CHARS=4500
CODEX_NO_PROJECT_WORKDIR=C:\Path\To\Temp\line-ai-agent-no-project
CODEX_PROJECTS_JSON={"LINE_AI_AGENT":"C:\\Path\\To\\LINE_AI_AGENT"}
CODEX_ALLOWED_PROJECT_ROOTS=C:\Path\To\Projects

LINE_AGENT_POLL_INTERVAL_SECONDS=5
LINE_AGENT_WORKER_CONCURRENCY=1
LINE_AGENT_ATTACHMENT_DOWNLOAD_DIR=.state\attachments

